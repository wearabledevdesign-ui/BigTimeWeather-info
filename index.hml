<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Big Time Weather - Wear OS Watch Face</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Hero Section -->
    <header class="max-w-4xl mx-auto px-6 py-16 text-center">
        <div class="inline-block bg-blue-600/20 text-blue-400 text-sm font-semibold px-4 py-1.5 rounded-full mb-6 border border-blue-500/30">
            Available on Wear OS
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6">
            Big Time <span class="text-blue-500">Weather</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
            A bold, elegant watch face and companion app designed to bring accurate weather forecasts and glanceable metrics straight to your wrist.
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
            <a href="https://play.google.com/store/apps/details?id=com.luly.bigtimeweather" target="_blank" 
               class="bg-blue-600 hover:bg-blue-500 text-white font-medium px-8 py-3.5 rounded-xl shadow-lg shadow-blue-600/30 transition-all flex items-center gap-3">
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M3.609 1.814L13.792 12 3.61 22.186a1.492 1.492 0 0 1-.61-.186V2a1.49 1.49 0 0 1 .609-.186zM15.208 13.416l2.121 2.121-11.455 6.622c-.636.368-1.218.256-1.391-.078L15.208 13.416zm0-2.832L4.483 1.913c.173-.334.755-.446 1.391-.078l11.455 6.622-2.121 2.121zm2.828 2.828l3.18 1.838c.636.367.636.965 0 1.332l-2.474 1.43-2.706-2.706 2-1.894z"/>
                </svg>
                Get it on Google Play
            </a>
        </div>
    </header>

    <!-- Screenshots / Preview Section -->
    <section class="max-w-5xl mx-auto px-6 py-12">
        <h2 class="text-2xl font-bold text-center mb-8 text-slate-200">Designed for Your Wrist</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Replace src with your screenshot image paths later -->
            <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-4 flex flex-col items-center justify-center h-80 text-slate-500">
                <span class="text-sm">[ Screenshot 1 ]</span>
                <span class="text-xs text-slate-600 mt-2">Watch Face Preview</span>
            </div>
            <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-4 flex flex-col items-center justify-center h-80 text-slate-500">
                <span class="text-sm">[ Screenshot 2 ]</span>
                <span class="text-xs text-slate-600 mt-2">Weather Complications</span>
            </div>
            <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-4 flex flex-col items-center justify-center h-80 text-slate-500 sm:col-span-2 lg:col-span-1">
                <span class="text-sm">[ Screenshot 3 ]</span>
                <span class="text-xs text-slate-600 mt-2">Companion App</span>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="max-w-4xl mx-auto px-6 py-12">
        <h2 class="text-2xl font-bold text-center mb-10 text-slate-200">Key Features</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-slate-800/40 border border-slate-700/40 p-6 rounded-2xl">
                <h3 class="font-semibold text-lg text-blue-400 mb-2">Glanceable Layout</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Large typography ensures time and critical weather updates are readable instantly with a quick glance.</p>
            </div>
            <div class="bg-slate-800/40 border border-slate-700/40 p-6 rounded-2xl">
                <h3 class="font-semibold text-lg text-blue-400 mb-2">Accurate Conditions</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Reliable meteorological updates synced smoothly to keep you prepared throughout your day.</p>
            </div>
            <div class="bg-slate-800/40 border border-slate-700/40 p-6 rounded-2xl">
                <h3 class="font-semibold text-lg text-blue-400 mb-2">Optimized Battery</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Engineered efficiently for Wear OS devices to preserve battery life without compromising performance.</p>
            </div>
            <div class="bg-slate-800/40 border border-slate-700/40 p-6 rounded-2xl">
                <h3 class="font-semibold text-lg text-blue-400 mb-2">Custom Complications</h3>
                <p class="text-slate-400 text-sm leading-relaxed">Tailor your watch face layout to display the data metrics that matter most to you.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="max-w-4xl mx-auto px-6 py-10 text-center text-slate-500 text-sm border-t border-slate-800 mt-12 w-full">
        <p>&copy; 2026 Big Time Weather. All rights reserved.</p>
    </footer>

</body>
</html>
